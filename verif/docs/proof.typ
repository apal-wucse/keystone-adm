// Body of PROOF.typ and PROOF.en.typ: the proofs of verif/rocq/ADM.v and
// ADMRegions.v as figures of natural deduction.  The figures are shared
// (proof-gen.typ, generated by prooftree.py); only the prose depends on the
// language.
#import "rocq.typ": *
#import "prooftree.typ": tree
#import "proof-gen.typ": initial, preservation, regions, states, stepcases, steps

#let lf(c) = (c: c)
#let inf(c, n, ..p) = (c: c, n: n, p: p.pos())
#let over(c, r) = (c: c, r: r)
#let K = math.op("K")

#let proof-body(lang) = {
  let t(ja, en) = if lang == "ja" { ja } else { en }
  let fig(name, ja, en) = [=== #raw(name) #h(0.6em) #text(weight: "regular", t(ja, en))]
  set par(leading: 0.9em)
  [
    = #t("1. この文書について", "1. About this document")

    #t(
      [`verif/rocq/ADM.v` と `ADMRegions.v` の証明を、自然演繹の証明図（ゲンツェン流の木）として書いたもの。],
      [The proofs of `verif/rocq/ADM.v` and `ADMRegions.v`, written as figures of natural deduction (trees in the style of Gentzen).],
    )

    #t(
      [対象は、Keystone の Additional Data Memory（ADM）の設計モデルである。ADM は、エンクレーブがホストと共有できるメモリ領域で、Security Monitor（SM）が PMP で保護し、書き込み可能な共有の後は内容を検証してからエンクレーブに戻す。モデルは、SM の動作を状態遷移系として書いたもので、hart とエンクレーブの数、ADM の内容、検証の述語を任意とする。],
      [The subject is the design model of the Additional Data Memory (ADM) of Keystone. The ADM is a memory region that an enclave can share with the host; the Security Monitor (SM) protects it with the PMP and, after a writable share, validates its contents before it returns to the enclave. The model describes the SM as a transition system, for any number of harts and enclaves, any ADM contents, and any validation predicate.],
    )

    #t(
      [2節でモデルの定義（状態、遷移関係、不変条件）と証明する定理を示し、3節で証明図の記法と推論規則を定める。4節以降が証明図である。],
      [Section 2 gives the definitions of the model (states, transition relation, invariant) and the theorems to prove, and Section 3 the notation and the inference rules of the figures. The figures are in Section 4 and after.],
    )

    #t([Rocq の証明との関係は次のとおり。], [The figures relate to the Rocq proofs as follows.])

    - #t(
        [*図は Rocq が検査した証明である。* 生成器（`docs/prooftree.py`）は、各図を Rocq の補題として書き出す。補題の証明は、図の推論1つにつきタクティク1ステップである（3.5節）。`make prove-figures` がこれを Rocq に検査させる。図は428個（5節に載せないフレームの場合83個を含む）で、すべて通る。],
        [*The figures are proofs checked by Rocq.* The generator (`docs/prooftree.py`) writes each figure as a Rocq lemma whose proof has one tactic step for each inference of the figure (Section 3.5). `make prove-figures` has Rocq check them. There are 428 figures (with the 83 frame cases that Section 5 does not show), and all of them pass.],
      )
    - #t(
        [*`ADM.v` の定理は図の証明だけから従う。* 書き出したファイル `FigADM.v` は、`ADM.v` の定義に図の証明を続けたもので、`ADM.v` 自身の証明と自動化タクティク（`crush`、`act`）を使わない。そこで、`inv_reachable` を含め、`ADM.v` の定理・補題と同じ文の24個が証明され、どれも公理に依存しない。`ADMRegions.v` の図は、そのファイルに補題として加えて検査する（`FigRegions.v`）。],
        [*The theorems of `ADM.v` follow from the proofs of the figures alone.* The generated file `FigADM.v` is the definitions of `ADM.v` followed by the proofs of the figures; it uses neither the proofs of `ADM.v` nor its automation (`crush`, `act`). It proves 24 statements of `ADM.v` (`inv_reachable`, the theorems, and two lemmas), none of which depends on an axiom. The figures of `ADMRegions.v` are checked as lemmas added to that file (`FigRegions.v`).],
      )
    - #t(
        [*`ADM.v` の証明そのものではない。* `ADM.v` は、不変条件の保存と遷移の性質を自動化タクティクで閉じるので、読める形の証明を持たない。図は、同じ手順（決定可能な等式の場合分け、不変条件の具体化、前向きの推論、等式の推論）で生成器が作った別の証明である。状態の性質（6節）と領域の性質（8節）は、`ADM.v` と `ADMRegions.v` の証明スクリプトと同じ不変条件、補題、場合分けから作った。スクリプトが型の構成子で場合分けする箇所は、図では等式の場合分け（dec）か値の網羅（exh）になる。],
        [*They are not the proofs of `ADM.v` themselves.* `ADM.v` closes the preservation of the invariant and the step properties with its automation, so it has no proof in a readable form. The figures are other proofs, made by the generator with the same procedure (case analysis on decidable equalities, instances of the invariant clauses, forward chaining, equational reasoning). The state properties (Section 6) and the region properties (Section 8) are made from the invariant clauses, lemmas and case analyses of the proof scripts of `ADM.v` and `ADMRegions.v`. Where a script analyses a value by its constructors, the figure has a case analysis on an equality (dec) or on the values (exh).],
      )
    - #t(
        [*1ステップの大きさ。* 論理の規則は Rocq の基本タクティク1つに当たる。$=$ は `congruence`（2つ目の形は等式による書き換え）に、post は遷移後の状態の定義の展開と `if` の場合分けに任せる。$=$ は、図に書いた前提だけを残して（`clear`）実行する。],
        [*The size of a step.* A logical rule is one basic tactic of Rocq. $=$ is left to `congruence` (its second form to rewriting with the equations), and post to unfolding the definition of the post-state and deciding its `if`. $=$ runs with only the premises written in the figure (`clear`).],
      )
    - #t(
        [*図の形の検査。* これとは別に、生成器は出力する図について、各推論が3節の規則の適用になっていること、$forall$I と $exists$E の変数の条件、仮定がすべて解消されていることを検査する。],
        [*Check of the shape.* Apart from this, the generator checks for every figure it writes that each inference is an instance of a rule of Section 3, the conditions on the variables of $forall$I and $exists$E, and that no assumption is left open.],
      )

    #t(
      [各図は、使う不変条件の数が最小になるように選んである。],
      [Each figure is chosen to use as few invariant clauses as possible.],
    )

    #rocq-appendix(lang, prefix: "2", title: t([2\. モデルと定理], [2\. The model and the theorems]), full: true)

    = #t("3. 記法と推論規則", "3. Notation and inference rules")

    == #t("3.1 記法", "3.1 Notation")

    - #t(
        [$sigma$ は遷移前、$sigma'$ は遷移後の状態で、$st'(x)$ のようにプライムをつけた値は $sigma'$ のものである。],
        [$sigma$ is the state before a transition and $sigma'$ the state after it; a primed value such as $st'(x)$ belongs to $sigma'$.],
      )
    - #t(
        [$e$, $h$, $d$, $m_0$, $s$, $m$ は遷移規則の引数（2.2節）、$x$, $y$, $z$ は示す性質の変数である。存在量化から取り出した変数には添字をつける（$e_1$, $h_1$）。],
        [$e$, $h$, $d$, $m_0$, $s$ and $m$ are the parameters of the transition rule (Section 2.2); $x$, $y$ and $z$ are the variables of the property to prove. A variable taken out of an existential has an index ($e_1$, $h_1$).],
      )
    - #t(
        [$[A]^n$ は仮定で、同じ番号 $n$ をもつ規則がそれを解消する。番号は図ごとにつける。],
        [$[A]^n$ is an assumption, discharged by the rule that carries the same number $n$. The numbers are local to a figure.],
      )
    - #t(
        [$Pi_k$ は別に示した部分導出である。2回以上現れる部分と、幅に収まらない部分をこうして分ける。$Pi_k$ の中の仮定は、それを使う図の規則が解消する。],
        [$Pi_k$ is a subderivation shown separately: one that occurs more than once, or one that does not fit in the width. An assumption inside $Pi_k$ is discharged by a rule of the figure that uses it.],
      )
    - #t(
        [$Keep(k)$ は $k = sharenone or k = sharero or k = invol or k = exit$、$R = emptyset$ は $forall a. thick a in.not R$、$a in Prot(x)$ は $a in epm(x) or a in adm(x)$ の略記である。],
        [$Keep(k)$ abbreviates $k = sharenone or k = sharero or k = invol or k = exit$; $R = emptyset$ abbreviates $forall a. thick a in.not R$; $a in Prot(x)$ abbreviates $a in epm(x) or a in adm(x)$.],
      )

    == #t("3.2 論理の規則", "3.2 Logical rules")

    #t(
      [直観主義の自然演繹の規則である。$not A$ は $A -> bot$ として扱う。],
      [The rules of intuitionistic natural deduction. $not A$ is treated as $A -> bot$.],
    )

    #tree(size: 9pt, inf($A_1 and dots.c and A_n$, [$and$I], lf($A_1$), lf($dots.c$), lf($A_n$)))
    #tree(size: 9pt, inf($A_i$, [$and$E], lf($A_1 and dots.c and A_n$)))
    #tree(size: 9pt, inf($A_1 or dots.c or A_n$, [$or$I], lf($A_i$)))
    #tree(size: 9pt, inf($C$, [$or$E#super[1,…,n]], lf($A_1 or dots.c or A_n$), over($C$, $[A_1]^1$), lf($dots.c$), over($C$, $[A_n]^n$)))
    #tree(size: 9pt, inf($A -> B$, [$->$I#super[1]], over($B$, $[A]^1$)))
    #tree(size: 9pt, inf($B$, [$->$E], lf($A -> B$), lf($A$)))
    #tree(size: 9pt, inf($not A$, [$not$I#super[1]], over($bot$, $[A]^1$)))
    #tree(size: 9pt, inf($bot$, [$not$E], lf($not A$), lf($A$)))
    #tree(size: 9pt, inf($A$, [$bot$E], lf($bot$)))
    #tree(size: 9pt, inf($forall v. thick A$, [$forall$I], lf($A$)))
    #tree(size: 9pt, inf($A[t\/v]$, [$forall$E], lf($forall v. thick A$)))
    #tree(size: 9pt, inf($exists v. thick A$, [$exists$I], lf($A[t\/v]$)))
    #tree(size: 9pt, inf($C$, [$exists$E#super[1]], lf($exists v. thick A$), over($C$, $[A[v_1\/v]]^1$)))

    #t(
      [$forall$I の $v$ は解消されていない仮定に現れない。$exists$E の $v_1$ は $C$ と他の仮定に現れない。],
      [In $forall$I, $v$ does not occur in an open assumption. In $exists$E, $v_1$ occurs neither in $C$ nor in another assumption.],
    )

    == #t("3.3 等式と型の規則", "3.3 Rules for equality and for the types")

    #tree(size: 9pt, inf($t = u$, [$=$], lf($t_1 = u_1$), lf($dots.c$), lf($t_n = u_n$)))
    #tree(size: 9pt, inf($A'$, [$=$], lf($A$), lf($t_1 = u_1$), lf($dots.c$), lf($t_n = u_n$)))
    #tree(size: 9pt, inf($bot$, [dis], lf($c = c'$)))
    #tree(size: 9pt, inf($t = u or t != u$, [dec]))
    #tree(size: 9pt, inf($t = c_1 or dots.c or t = c_n$, [exh]))

    - #t(
        [$=$（1つ目）：$t = u$ が、前提の等式から反射・対称・推移・合同と、構成子 $Enc$, $Sm$ の単射性で得られる。前提がなければ反射である。],
        [$=$ (first form): $t = u$ follows from the premises by reflexivity, symmetry, transitivity, congruence, and the injectivity of the constructors $Enc$ and $Sm$. Without premises it is reflexivity.],
      )
    - #t(
        [$=$（2つ目）：$A'$ は、$A$ の中の項を、前提の等式で等しい項に置き換えたものである。],
        [$=$ (second form): $A'$ is $A$ with terms replaced by terms that the premises make equal.],
      )
    - #t(
        [dis：$c$ と $c'$ は異なる構成子（$FRESH$ と $RUNNING$、$Host$ と $Enc(x)$、$bot$ と $h$ など）である。],
        [dis: $c$ and $c'$ are distinct constructors (such as $FRESH$ and $RUNNING$, $Host$ and $Enc(x)$, $bot$ and $h$).],
      )
    - #t(
        [dec：等号が決定可能な型の項に使う。$E$ と $H$ は仮定（`eid_eq_dec`, `hart_eq_dec`）により、有限の型とそれらから作る型は定義により決定可能である。$D$ と $M$ の項には使わない。],
        [dec: used for terms of a type with decidable equality. $E$ and $H$ are decidable by hypothesis (`eid_eq_dec`, `hart_eq_dec`); the finite types and the types built from them are decidable by definition. It is not used for terms of $D$ and $M$.],
      )
    - #t(
        [exh：有限の型の値の網羅（$s = NONE or s = RONLY or s = RW$ など）。$rn(e)$ では $(exists h'. thick rn(e) = h') or rn(e) = bot$ である。],
        [exh: the values of a finite type are exhaustive (such as $s = NONE or s = RONLY or s = RW$). For $rn(e)$ it is $(exists h'. thick rn(e) = h') or rn(e) = bot$.],
      )

    == #t("3.4 モデルの規則", "3.4 Rules of the model")

    #tree(size: 9pt, inf($A$, [pre]))
    #tree(size: 9pt, inf($f'(dots.c) = v$, [post], lf($C_1$), lf($dots.c$), lf($C_n$)))
    #tree(size: 9pt, inf($f(dots.c) = v$, [init]))
    #tree(size: 9pt, inf($A$, [def]))
    #tree(size: 9pt, inf($B$, [$K$], lf($A_1$), lf($dots.c$), lf($A_n$)))

    - #t(
        [pre：その場合の遷移規則の前提（2.2節 の「前提」の列）。],
        [pre: a premise of the transition rule of the case (column "Premises" of Section 2.2).],
      )
    - #t(
        [post：その遷移規則による遷移後の値（「遷移後の状態」の列）。規則が $e$ の値だけを変えるとき、$f'(e) = v$ は前提なしで、$f'(x) = f(x)$ は前提 $x != e$ から得られる。hart についても同様である。規則が触れない値は、前提なしで $f'(x) = f(x)$ である。値が共有状態 $s$ で決まるときは、$s = RW$ などが前提になる。],
        [post: a value after the transition (column "Post-state"). When the rule changes the value at $e$ only, $f'(e) = v$ has no premise, and $f'(x) = f(x)$ follows from the premise $x != e$; likewise for harts. For a value that the rule does not touch, $f'(x) = f(x)$ has no premise. When the value depends on the sharing state $s$, a premise such as $s = RW$ selects it.],
      )
    - #t([init：初期状態 $sigma_0$ の値。], [init: a value of the initial state $sigma_0$.])
    - #t(
        [def：定義の展開（$hp$、$<=$、$a in.not emptyset$）。],
        [def: unfolding of a definition ($hp$, $<=$, $a in.not emptyset$).],
      )
    - #t(
        [$K$（S1, …, E2）：$Inv(sigma)$ の条件 $K$ を変数に具体化したもの。条件が $A_1 ==> dots.c ==> A_n ==> B$ のとき、前提が $A_1, …, A_n$、結論が $B$ である。ctx と phase は補題 `running_of_ctx`、`running_of_phase`（6節）、C1 と IH は8節の帰納法の仮定を同じ形で使う。],
        [$K$ (S1, …, E2): the clause $K$ of $Inv(sigma)$ at given variables. For a clause $A_1 ==> dots.c ==> A_n ==> B$, the premises are $A_1, …, A_n$ and the conclusion is $B$. ctx and phase use the lemmas `running_of_ctx` and `running_of_phase` (Section 6), and C1 and IH the induction hypotheses of Section 8, in the same way.],
      )

    == #t("3.5 Rocq のタクティクとの対応", "3.5 Correspondence with the Rocq tactics")

    #t(
      [書き出した Rocq の証明では、図の推論が次のタクティクになる。$Q$ は前提の導出を `assert` で先に証明して得た仮定、$H_n$ は仮定 $[A]^n$ である。],
      [In the generated Rocq proofs, an inference of a figure becomes the following tactic. $Q$ is a hypothesis obtained by proving the derivation of a premise first with `assert`, and $H_n$ is the assumption $[A]^n$.],
    )

    #table(
      columns: (1fr, 3fr),
      table.header([*#t("図の規則", "Rule")*], [*Rocq*]),
      [$[A]^n$], [`exact Hn`],
      [$->$I, $not$I, $forall$I], [`intro Hn`#t("、", ", ")`intro v`],
      [$->$E, $not$E], [`refine (Q _)`],
      [$and$I, $and$E], [`split`#t("、", ", ")`exact (proj1 Q)`#t(" など", " and the like")],
      [$or$I, $or$E], [`left` / `right`#t("、", ", ")`destruct Q as [H1 | H2]`],
      [$bot$E], [`exfalso`],
      [$forall$E, $exists$I, $exists$E], [`exact (Q t)`#t("、", ", ")`exists t`#t("、", ", ")`destruct Q as [v Hn]`],
      [$=$], [`clear - Q1 … Qn; congruence`#t("（2つ目の形は等式による書き換え）", " (second form: rewriting with the equations)")],
      [dis], [`discriminate Q`],
      [dec, exh], [`destruct (eid_eq_dec x e)`#t("、", ", ")`destruct t`],
      [pre], [`assumption`],
      [post], [#t([遷移後の状態の定義を展開し、`if` を前提で決める], [unfold the definition of the post-state and decide its `if` by the premises])],
      [init, def], [`reflexivity`],
      [$K$], [`refine (i_k s HI x y _)`],
      [#t("遷移規則による場合分け（4節）", "case analysis on the transition rule (Section 4)")], [`destruct Hst`],
      [#t("帰納法（4節）", "induction (Section 4)")], [`induction`],
    )

    = #t([4\. 不変条件（`inv_init`, `inv_step`, `inv_reachable`）], [4\. The invariant (`inv_init`, `inv_step`, `inv_reachable`)])

    == #t("4.1 構成", "4.1 Structure")

    #t(
      [$Reach$ は $sigma_0 in Reach$ と「$sigma in Reach$ かつ $sigma -> sigma'$ ならば $sigma' in Reach$」で生成されるので、次の帰納法が使える（`inv_reachable`）。],
      [$Reach$ is generated by $sigma_0 in Reach$ and "$sigma' in Reach$ if $sigma in Reach$ and $sigma -> sigma'$", which gives the following induction (`inv_reachable`).],
    )

    #tree(size: 9pt, inf(
      $forall sigma in Reach. thick Inv(sigma)$, [ind#super[1,2]],
      inf($Inv(sigma_0)$, [`inv_init`]),
      inf($Inv(sigma')$, [`inv_step`], lf($[Inv(sigma)]^1$), lf($[sigma -> sigma']^2$)),
    ))

    #t(
      [$Inv$ は19条件の連言なので、`inv_init` と `inv_step` は条件 $K$ ごとの証明を $and$I でまとめたものである。$K(sigma)$ は「すべての変数について条件 $K$ が $sigma$ で成り立つ」ことを表す。],
      [$Inv$ is the conjunction of 19 clauses, so `inv_init` and `inv_step` collect one proof for each clause $K$ with $and$I. $K(sigma)$ stands for "clause $K$ holds in $sigma$ for all variables".],
    )

    #tree(size: 9pt, inf(
      $Inv(sigma')$, [$and$I],
      over($"S1"(sigma')$, [`p_s1`]), over($"S2"(sigma')$, [`p_s2`]), lf($dots.c$), over($"E2"(sigma')$, [`p_e2`]),
    ))

    #t(
      [補題 `p_k` は、$sigma -> sigma'$ を与える遷移規則で場合分けする（`destruct Hst`）。$sigma scripts(->)_R sigma'$ は、$sigma'$ が規則 $R$ で $sigma$ から得られることである。],
      [The lemma `p_k` analyses the transition rule that gives $sigma -> sigma'$ (`destruct Hst`). $sigma scripts(->)_R sigma'$ says that $sigma'$ is obtained from $sigma$ by rule $R$.],
    )

    #tree(size: 9pt, inf(
      $K(sigma')$, [#t("規則", "rule")#super[1,…,15]],
      lf($sigma -> sigma'$),
      over($K(sigma')$, $[sigma scripts(->)_"Create" sigma']^1$),
      over($K(sigma')$, $[sigma scripts(->)_"RunBegin" sigma']^2$),
      lf($dots.c$),
      over($K(sigma')$, $[sigma scripts(->)_"AdvWrite" sigma']^15$),
    ))

    #t(
      [5節の図は、この各枝、すなわち「$Inv(sigma)$ と規則 $R$ の前提から、$sigma'$ での条件 $K$ を導く」導出である。仮定 $sigma scripts(->)_R sigma'$ は規則 pre と post として、$Inv(sigma)$ は規則 S1, …, E2 として使う。結論の変数 $x$, $y$, $z$ は任意なので、$forall$I で $K(sigma')$ になる。],
      [The figures of Section 5 are these branches: derivations of clause $K$ in $sigma'$ from $Inv(sigma)$ and the premises of rule $R$. The assumption $sigma scripts(->)_R sigma'$ is used as the rules pre and post, and $Inv(sigma)$ as the rules S1, …, E2. The variables $x$, $y$ and $z$ of the conclusion are arbitrary, so $forall$I gives $K(sigma')$.],
    )

    == #t([4.2 初期状態（`inv_init`）], [4.2 The initial state (`inv_init`)])

    #t(
      [条件ごとの図。$sigma_0$ では前件が成り立たないか、後件がそのまま成り立つ。],
      [One figure for each clause. In $sigma_0$, either the antecedent fails or the consequent holds as it is.],
    )

    #initial

    = #t([5\. 不変条件の保存（`inv_step`）], [5\. Preservation of the invariant (`inv_step`)])

    #t(
      [条件 $K$ と遷移規則 $R$ の組ごとの図である（19 × 15 = 285）。*フレーム*と書いた規則は、条件 $K$ に現れる値を変えない。その場合の図はどれも次の形なので、個別には載せない（83件）。$A$ と $B$ は条件の前件と後件で、等式 $f'(dots.c) = f(dots.c)$ は post による。],
      [One figure for each pair of a clause $K$ and a transition rule $R$ (19 × 15 = 285). A rule listed under *Frame* does not change a value that occurs in clause $K$. The figure of such a case always has the following shape and is not shown (83 cases). $A$ and $B$ are the antecedent and the consequent of the clause, and the equations $f'(dots.c) = f(dots.c)$ are by post.],
    )

